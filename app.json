{
  "expo": {
    "name": "LittleKart",
    "slug": "shopping-cart-mobile",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlekart.shoppingcart",
      "buildNumber": "2",
      "appStoreUrl": "https://apps.apple.com/us/app/littlekart/id6757442090",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby stores and delivery availability.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location is required to detect your delivery location.",
        "NSMicrophoneUsageDescription": "LittleKart needs microphone access for voice search.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        },
        "LSApplicationQueriesSchemes": [
          "upi",
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "paytm",
          "bhim",
          "credpay",
          "amazonpay",
          "ppe"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.littlekart.shoppingcart",
      "versionCode": 20,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.littlekart.shoppingcart",
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c34c2471-e8cb-466c-b964-c4ebddf6d39b"
      }
    }
  }
}
